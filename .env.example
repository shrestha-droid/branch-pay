# Copy this file to .env and fill in the values. Never commit .env.

# --- PayPal (sandbox) ---
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# and copy its Client ID and Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the email of your sandbox BUSINESS account (shown as the invoice sender).
PAYPAL_MERCHANT_EMAIL=
BUSINESS_NAME=Branch Pay Demo Studio

# Optional: PayPal webhooks for instant payment detection (polling works without them).
# Point a sandbox webhook at https://<public-url>/api/paypal/webhook, subscribe to
# INVOICING.INVOICE.PAID and INVOICING.INVOICE.CANCELLED, and paste its Webhook ID here.
PAYPAL_WEBHOOK_ID=

# Sandbox is the default. Do not change this unless you know what you are doing.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- AI (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# "gemini-flash-latest" always points at the newest Flash model.
GEMINI_MODEL=gemini-flash-latest
# Tried in order if the main model is busy or unavailable.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash

# --- App ---
PORT=3000
# The Collector agent sends a payment reminder on its own after this many minutes (max 3 per invoice).
# 2 is good for a live demo. 0 = only when you press the button.
AUTO_REMIND_MINUTES=2
# Optional spending mandate: quotes at or under this many USD are approved without a human
# (the Biller then invoices straight away). 0 = a human approves every quote.
AUTO_APPROVE_UNDER_USD=0
# Hard cap on any quote the AI can create, in USD. Enforced in code, not by the AI.
MAX_QUOTE_USD=500
